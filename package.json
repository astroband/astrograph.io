{
  "name": "astrograph-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --build --force",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "eslint --fix",
    "deploy": "firebase deploy",
